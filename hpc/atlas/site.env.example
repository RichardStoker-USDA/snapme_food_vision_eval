# Site settings for the Slurm jobs in hpc/atlas. Copy to site.env (not tracked) and fill in.
export SNAPME_ROOT=/90daydata/<project>/snapme_food_vision_eval   # data, models, runs; never /home
export SBATCH_ACCOUNT=<slurm account>        # sbatch reads this, so the job scripts carry no --account line
export SNAPME_GROUP=proj-<project>           # shared group for files under SNAPME_ROOT (optional)
export SNAPME_EXCLUDE=""                     # comma-separated nodes to avoid, e.g. ones where CUDA fails to start
export SNAPME_PARTITIONS="l40s=gpu-l40s,a100=gpu-a100"   # GPU type=partition, smaller GPUs first; the GPU type
                                             # is the Slurm GRES name and the model files' [serve.<type>] key
